# Settings the examples run on. Copy to `examples/.env` and edit what a run needs; every line below
# carries the default that applies when the setting is absent, which is the local store
# `make examples-infra-up` starts. `examples/.env` is ignored by git - keep real keys there.
#
# A setting given in the environment wins over the one this file carries, so
# `JM_S3_BUCKET=other cargo run --example simple_job_s3` overrides a run without editing the file.

# Log filter, the same one RUST_LOG carries on the command line.
#RUST_LOG=info,jobmanager=debug

# Timeout of one storage operation, in whole seconds. Unset, each backend's own default stands - 5s,
# which a container on this machine answers within and a provider's service across the internet does
# not.
#JM_REQUEST_TIMEOUT_SECS=15

# --- S3, or any S3-compatible store -------------------------------------------------------------
# Against AWS the endpoint is `https://s3.<region>.amazonaws.com` and the region has to match it.
#JM_S3_ENDPOINT=http://localhost:9000
#JM_S3_ACCESS_KEY_ID=rustfsadmin
#JM_S3_SECRET_ACCESS_KEY=rustfsadmin
#JM_S3_BUCKET=jobs
#JM_S3_REGION=us-east-1

# --- Azure Blob Storage -------------------------------------------------------------------------
# The emulator addresses accounts by path, so its endpoint carries the account; the service
# addresses them by host - `https://<account>.blob.core.windows.net`, with the account named again
# in JM_AZURE_ACCOUNT. Shared Key is the only authentication this backend has, so the service needs
# an account key too, and an account whose `allowSharedKeyAccess` is off refuses every request.
#JM_AZURE_ENDPOINT=http://localhost:10000/devstoreaccount1
#JM_AZURE_ACCOUNT=devstoreaccount1
#JM_AZURE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
#JM_AZURE_CONTAINER=jobs

# --- Google Cloud Storage -----------------------------------------------------------------------
# The service answers at `https://storage.googleapis.com`. JM_GCS_CREDENTIALS takes `anonymous`
# (the emulator's way in, and the default), `adc` for Application Default Credentials, or the path
# of a service account key file. Of the three, only `anonymous` has been run end to end.
#JM_GCS_ENDPOINT=http://localhost:9199
#JM_GCS_BUCKET=jobs
#JM_GCS_PROJECT_ID=jobmanager-examples
#JM_GCS_CREDENTIALS=anonymous
